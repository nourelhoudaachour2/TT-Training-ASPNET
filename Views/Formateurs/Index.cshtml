@model IEnumerable<Training_tunisie_telecome.Models.Trainer>

@{
    ViewData["Title"] = "Formateurs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">


<style>

    .formateurs-container {
        background: white;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,.05);
        font-family: 'Montserrat', sans-serif;
    }


    .search-add {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }


    .search-box {
        width: 70%;
        position: relative;
    }


        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #14297a;
        }


        .search-box input {
            width: 100%;
            height: 42px;
            padding-left: 42px;
            border: 1px solid #dfe3eb;
            border-radius: 8px;
            outline: none;
            font-family: 'Montserrat',sans-serif;
        }


            .search-box input:focus {
                border-color: #14297a;
            }


    .btn-add {
        background: #14297a;
        color: white;
        padding: 10px 18px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }


        .btn-add:hover {
            background: #0d1b52;
            color: white;
        }


    table {
        width: 100%;
        border-collapse: collapse;
    }


    thead th {
        background: #fafafa;
        padding: 12px;
        color: #14297a;
        font-size: 13px;
        text-align: center;
        border-bottom: 1px solid #e5e7eb;
        font-weight: 700;
    }


    tbody td {
        padding: 10px;
        text-align: center;
        color: #374151;
        font-size: 14px;
    }


    .trainer-image {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }


    .no-image {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e8edff;
        color: #14297a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }


    .action-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        margin: 0 3px;
        font-size: 12px;
    }


    .details {
        background: #ede9fe;
        color: #6d28d9;
    }


    .edit {
        background: #e0e7ff;
        color: #14297a;
    }


    .badge-interne,
    .badge-externe {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }


    .badge-interne {
        background: #dcfce7;
        color: #15803d;
    }


    .badge-externe {
        background: #fef3c7;
        color: #b45309;
    }

</style>





<div class="formateurs-container">



    <div class="search-add">


        <div class="search-box">


            <i class="fa fa-search"></i>


            <input id="trainerSearch"
                   type="text"
                   placeholder="Rechercher un formateur..." />


        </div>





        <a asp-action="Create"
           class="btn-add">


            <i class="fa fa-plus"></i>

            Ajouter


        </a>


    </div>





    <table id="trainerTable">


        <thead>

            <tr>

                <th>
                    Image
                </th>


                <th>
                    Matricule
                </th>


                <th>
                    Nom
                </th>


                <th>
                    Prénom
                </th>


                <th>
                    Téléphone
                </th>


                <th>
                    Type
                </th>


                <th>
                    Actions
                </th>


            </tr>


        </thead>





        <tbody>


            @foreach (var item in Model)
            {


                <tr>


                    <td>


                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {

                            <img src="@item.ImagePath"
                                 class="trainer-image" />

                        }
                        else
                        {

                            <div class="no-image">

                                <i class="fa fa-user"></i>

                            </div>

                        }


                    </td>




                    <td>

                        @item.Matricule

                    </td>




                    <td>

                        @item.LastName

                    </td>




                    <td>

                        @item.FirstName

                    </td>




                    <td>

                        @item.Phone

                    </td>




                    <td>


                        @if (item.TrainerType == "Interne")
                        {

                            <span class="badge-interne">
                                Interne
                            </span>

                        }
                        else
                        {

                            <span class="badge-externe">
                                Externe
                            </span>

                        }


                    </td>





                    <td>


                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="action-btn details">


                            <i class="fa fa-eye"></i>


                        </a>





                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="action-btn edit">


                            <i class="fa fa-pen"></i>


                        </a>


                    </td>


                </tr>


            }


        </tbody>


    </table>



</div>






<script>


    document
        .getElementById("trainerSearch")
        .addEventListener("keyup", function() {


            let value = this.value.toLowerCase();


            document
                .querySelectorAll("#trainerTable tbody tr")
                .forEach(row => {


                    let text = row.innerText.toLowerCase();


                    row.style.display =
                        text.includes(value) ? "" : "none";


                });


        });


</script>