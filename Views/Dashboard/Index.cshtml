@using System.Globalization
@model Training_tunisie_telecome.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string[] domainColors =
    {
        "#12A8E0",
        "#EC3E96",
        "#FF7518",
        "#7C3AED",
        "#18B66A",
        "#F4B400"
    };

    var totalDomainLinks = Model.DomainValues.Sum();
    var frCulture = new CultureInfo("fr-FR");
}


<style>

    .dashboard-page {
        background: #f7f7fb;
        border-radius: 22px;
        padding: 20px;
    }


    /* =========================
               HEADER
            ========================= */

    .dashboard-welcome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .welcome-title {
        margin: 0;
        color: #14297a;
        font-size: 24px;
        font-weight: 750;
    }

    .welcome-subtitle {
        margin: 4px 0 0;
        color: #718096;
        font-size: 13px;
    }

    .today-card {
        height: 42px;
        padding: 0 16px;
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 9px;
        color: #14297a;
        font-size: 13px;
        white-space: nowrap;
    }

        .today-card i {
            color: #14297a;
        }


    /* =========================
               KPI
            ========================= */

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .kpi-card {
        min-height: 174px;
        background: white;
        border-radius: 18px;
        padding: 16px;
        text-align: center;
        position: relative;
        transition: transform .22s ease, box-shadow .22s ease;
    }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(20, 41, 122, .09);
        }

    .kpi-blue {
        border: 1.5px solid #bae6fd;
    }

    .kpi-purple {
        border: 1.5px solid #d8b4fe;
    }

    .kpi-green {
        border: 1.5px solid #86efac;
    }

    .kpi-orange {
        border: 1.5px solid #fed7aa;
    }

    .kpi-pink {
        border: 1.5px solid #f9a8d4;
    }

    .kpi-icon {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        margin: 0 auto 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .icon-blue {
        background: #e0f2fe;
        color: #0284c7;
    }

    .icon-purple {
        background: #ede9fe;
        color: #7c3aed;
    }

    .icon-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .icon-orange {
        background: #ffedd5;
        color: #ea580c;
    }

    .icon-pink {
        background: #fce7f3;
        color: #db2777;
    }

    .kpi-label {
        color: #718096;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .kpi-number {
        color: #14297a;
        font-size: 27px;
        font-weight: 700;
        line-height: 1.1;
    }

    .kpi-caption {
        margin-top: 7px;
        color: #94a3b8;
        font-size: 11.5px;
    }

    .kpi-trend {
        margin-top: 4px;
        font-size: 11px;
        font-weight: 700;
    }

    .trend-up {
        color: #16a34a;
    }

    .trend-flat {
        color: #94a3b8;
    }


    /* =========================
               COMMON CARD
            ========================= */

    .dashboard-card {
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 18px;
        padding: 18px;
        min-width: 0;
    }

    .card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 15px;
    }

    .card-heading {
        color: #14297a;
        font-size: 16px;
        font-weight: 750;
        margin: 0;
    }

    .card-subheading {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 3px;
    }

    .card-action-icon {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        border: 1px solid #edf0f5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        background: #fff;
        flex: 0 0 30px;
    }

    .card-footer-link {
        display: block;
        margin-top: 12px;
        color: #12A8E0;
        font-size: 12.5px;
        font-weight: 700;
        text-decoration: none;
    }

        .card-footer-link:hover {
            text-decoration: underline;
        }


    /* =========================
               ANALYTICS
            ========================= */

    .analytics-grid {
        display: grid;
        grid-template-columns: 1.55fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    .domain-content {
        display: grid;
        grid-template-columns: 210px 1fr;
        gap: 22px;
        align-items: center;
    }

    .domain-chart-box {
        width: 210px;
        height: 210px;
        margin: auto;
        position: relative;
    }

    .domain-center {
        position: absolute;
        inset: 0;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .domain-center strong {
            font-size: 25px;
            color: #14297a;
        }

        .domain-center span {
            color: #94a3b8;
            font-size: 11px;
        }

    .domain-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .domain-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
        align-items: center;
    }

    .domain-name {
        min-width: 0;
        color: #475569;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .domain-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex: 0 0 9px;
    }

    .domain-value {
        color: #14297a;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .chart-container {
        position: relative;
        height: 250px;
    }


    /* =========================
               OPERATIONAL SECTION
            ========================= */

    .operations-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .compact-list {
        display: flex;
        flex-direction: column;
    }

    .session-row,
    .formation-row {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px 0;
        border-bottom: 1px solid #f0f2f6;
    }

        .session-row:last-child,
        .formation-row:last-child {
            border-bottom: none;
        }

    .date-box-small {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: #eef2ff;
        color: #4338ca;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 0 0 46px;
    }

    .date-day {
        font-size: 15px;
        font-weight: 800;
        line-height: 1;
    }

    .date-month {
        margin-top: 3px;
        font-size: 9px;
        text-transform: uppercase;
    }

    .row-main {
        flex: 1;
        min-width: 0;
    }

    .row-title {
        color: #1e293b;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .row-subtitle {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .row-subtitle i {
            margin-right: 4px;
        }

    .participant-chip {
        display: flex;
        align-items: center;
        gap: 5px;
        color: #64748b;
        font-size: 11.5px;
        white-space: nowrap;
    }

    .status-badge {
        flex: 0 0 auto;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-confirmed {
        background: #dcfce7;
        color: #16a34a;
    }

    .status-planned {
        background: #ffedd5;
        color: #ea580c;
    }

    .formation-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 42px;
    }

    .circle-purple {
        background: #ede9fe;
        color: #7c3aed;
    }

    .circle-blue {
        background: #e0f2fe;
        color: #0284c7;
    }

    .circle-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .circle-orange {
        background: #ffedd5;
        color: #ea580c;
    }

    .circle-pink {
        background: #fce7f3;
        color: #db2777;
    }


    /* =========================
               EMPTY STATE
            ========================= */

    .empty-state {
        min-height: 180px;
        border: 1px dashed #dfe4ec;
        border-radius: 14px;
        background: #fbfcfe;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
    }

    .empty-state-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: #7c3aed;
        margin-bottom: 9px;
    }

    .empty-state strong {
        color: #14297a;
        font-size: 13px;
    }

    .empty-state span {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 4px;
    }


    /* =========================
               RESPONSIVE
            ========================= */

    @@media(max-width:900px) {

        .operations-grid {
            grid-template-columns: 1fr;
        }

        .domain-content {
            grid-template-columns: 1fr;
        }

        .dashboard-welcome {
            align-items: flex-start;
            flex-direction: column;
        }
    }

</style>



<div class="dashboard-page">


    <div class="dashboard-welcome">

        <div>
            <h2 class="welcome-title">
                Bienvenue, Responsable RH 
            </h2>

            <p class="welcome-subtitle">
                Vue synthétique de l'activité formation
            </p>
        </div>


        <div class="today-card">
            <i class="fa-solid fa-calendar-day"></i>
            Aujourd'hui : @DateTime.Today.ToString("dd/MM/yyyy")
        </div>

    </div>



    <div class="kpi-grid">


        <div class="kpi-card kpi-pink">

            <div class="kpi-icon icon-pink">
                <i class="fa-solid fa-user-group"></i>
            </div>

            <div class="kpi-label">
                Employés
            </div>

            <div class="kpi-number">
                @Model.TotalEmployees
            </div>

            <div class="kpi-caption">
                employés enregistrés
            </div>

        </div>



        <div class="kpi-card kpi-green">

            <div class="kpi-icon icon-green">
                <i class="fa-solid fa-chalkboard-user"></i>
            </div>

            <div class="kpi-label">
                Formateurs
            </div>

            <div class="kpi-number">
                @Model.TotalTrainers
            </div>

            <div class="kpi-caption">
                formateurs disponibles
            </div>

        </div>



        <div class="kpi-card kpi-blue">

            <div class="kpi-icon icon-blue">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <div class="kpi-label">
                Formations
            </div>

            <div class="kpi-number">
                @Model.TotalFormations
            </div>

            <div class="kpi-caption">
                formations enregistrées
            </div>

            <div class="kpi-trend trend-up">
                <i class="fa-solid fa-arrow-trend-up"></i> 12% vs mois dernier
            </div>

        </div>



        <div class="kpi-card kpi-purple">

            <div class="kpi-icon icon-purple">
                <i class="fa-solid fa-clock"></i>
            </div>

            <div class="kpi-label">
                Heures formation
            </div>

            <div class="kpi-number">
                @Model.TotalTrainingHours
            </div>

            <div class="kpi-caption">
                heures réalisées
            </div>

            <div class="kpi-trend trend-up">
                <i class="fa-solid fa-arrow-trend-up"></i> activité formation
            </div>

        </div>



        <div class="kpi-card kpi-orange">

            <div class="kpi-icon icon-orange">
                <i class="fa-solid fa-wallet"></i>
            </div>

            <div class="kpi-label">
                Budget total
            </div>

            <div class="kpi-number">
                @Model.TotalBudget.ToString("N0") DT
            </div>

            <div class="kpi-caption">
                coûts enregistrés
            </div>

            <div class="kpi-trend trend-up">
                <i class="fa-solid fa-arrow-up"></i> 8% vs mois dernier
            </div>

        </div>


    </div>




    <div class="analytics-grid">


        <div class="dashboard-card">

            <div class="card-header">

                <div>
                    <h3 class="card-heading">
                        Répartition des formations par domaine
                    </h3>

                    <div class="card-subheading">
                        Distribution actuelle du catalogue
                    </div>
                </div>

                <div class="card-action-icon">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>

            </div>


            @if (Model.DomainLabels.Count > 0)
            {
                <div class="domain-content">

                    <div class="domain-chart-box">

                        <canvas id="domainChart"></canvas>

                        <div class="domain-center">
                            <strong>@totalDomainLinks</strong>
                            <span>affectations</span>
                        </div>

                    </div>


                    <div class="domain-list">

                        @for (var i = 0; i < Model.DomainLabels.Count; i++)
                        {
                            var value = Model.DomainValues[i];

                            var percentage =
                                totalDomainLinks > 0
                                    ? Math.Round(value * 100.0 / totalDomainLinks)
                                    : 0;


                            <div class="domain-row">

                                <div class="domain-name">

                                    <span class="domain-dot"
                                          style="background:@domainColors[i % domainColors.Length]">
                                    </span>

                                    <span>
                                        @Model.DomainLabels[i]
                                    </span>

                                </div>


                                <div class="domain-value">
                                    @percentage% (@value)
                                </div>

                            </div>
                        }

                    </div>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>

                    <strong>
                        Aucun domaine disponible
                    </strong>

                    <span>
                        Les statistiques apparaîtront après l'ajout des formations.
                    </span>

                </div>
            }

        </div>



        <div class="dashboard-card">

            <div class="card-header">

                <div>
                    <h3 class="card-heading">
                        Évolution des sessions
                    </h3>

                    <div class="card-subheading">
                        12 dernières périodes enregistrées
                    </div>
                </div>

                <div class="card-action-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

            </div>


            @if (Model.MonthlyLabels.Count > 0)
            {
                <div class="chart-container">
                    <canvas id="sessionChart"></canvas>
                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <strong>
                        Aucun historique
                    </strong>

                    <span>
                        L'évolution apparaîtra lorsque des sessions seront disponibles.
                    </span>

                </div>
            }

        </div>


    </div>




    <div class="operations-grid">


        <div class="dashboard-card">

            <div class="card-header">

                <div>
                    <h3 class="card-heading">
                        Prochaines sessions
                    </h3>

                    <div class="card-subheading">
                        Sessions dont la date de début n'est pas encore passée
                    </div>
                </div>

                <div class="card-action-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>

            </div>


            @if (Model.UpcomingSessions.Count > 0)
            {
                <div class="compact-list">

                    @foreach (var session in Model.UpcomingSessions)
                    {
                        var daysUntil = (session.Date.Date - DateTime.Today).Days;
                        var isConfirmed = daysUntil <= 7;
                        var statusLabel = isConfirmed ? "Confirmée" : "Planifiée";
                        var statusClass = isConfirmed ? "status-confirmed" : "status-planned";

                        <div class="session-row">

                            <div class="date-box-small">

                                <div class="date-day">
                                    @session.Date.ToString("dd")
                                </div>

                                <div class="date-month">
                                    @session.Date.ToString("MMM", frCulture)
                                </div>

                            </div>


                            <div class="row-main">

                                <div class="row-title">
                                    @session.Formation
                                </div>

                                <div class="row-subtitle">

                                    <i class="fa-solid fa-location-dot"></i>

                                    @(string.IsNullOrWhiteSpace(session.Location)
                                        ? "Lieu non renseigné"
                                        : session.Location)

                                </div>

                            </div>


                            <div class="participant-chip">

                                <i class="fa-solid fa-users"></i>

                                @session.Participants

                            </div>


                            <span class="status-badge @statusClass">
                                @statusLabel
                            </span>

                        </div>
                    }

                </div>

                <a class="card-footer-link" asp-controller="Formations" asp-action="Index">
                    Voir toutes les sessions →
                </a>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <strong>
                        Aucune prochaine session
                    </strong>

                    <span>
                        Les prochaines sessions apparaîtront automatiquement ici.
                    </span>

                </div>
            }

        </div>



        <div class="dashboard-card">

            <div class="card-header">

                <div>
                    <h3 class="card-heading">
                        Dernières formations ajoutées
                    </h3>

                    <div class="card-subheading">
                        Les dernières formations du catalogue
                    </div>
                </div>

                <div class="card-action-icon">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>

            </div>


            @if (Model.RecentFormations.Count > 0)
            {
                string[] formationIconClasses =
                {
                    "circle-purple",
                    "circle-blue",
                    "circle-green",
                    "circle-orange",
                    "circle-pink"
                };


                <div class="compact-list">

                    @for (var i = 0; i < Model.RecentFormations.Count; i++)
                    {
                        var formation = Model.RecentFormations[i];

                        <div class="formation-row">

                            <div class="formation-circle @formationIconClasses[i % formationIconClasses.Length]">

                                <i class="fa-solid fa-book-open"></i>

                            </div>


                            <div class="row-main">

                                <div class="row-title">
                                    @formation.Title
                                </div>


                                <div class="row-subtitle">

                                    @if (formation.Date != default(DateTime))
                                    {
                                        <span>
                                            <i class="fa-regular fa-calendar"></i>
                                            @formation.Date.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Aucune session planifiée
                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="participant-chip">

                                <i class="fa-solid fa-users"></i>

                                @formation.Participants

                            </div>

                        </div>
                    }

                </div>

                <a class="card-footer-link" asp-controller="Formations" asp-action="Index">
                    Voir toutes les formations →
                </a>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>

                    <strong>
                        Aucune formation
                    </strong>

                    <span>
                        Les formations récemment ajoutées apparaîtront ici.
                    </span>

                </div>
            }

        </div>


    </div>


</div>



<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const domainCanvas = document.getElementById('domainChart');

    if (domainCanvas) {

        const domainColors = [
            '#12A8E0',
            '#EC3E96',
            '#FF7518',
            '#7C3AED',
            '#18B66A',
            '#F4B400'
        ];

        new Chart(domainCanvas, {

            type: 'doughnut',

            data: {

                labels: @Html.Raw(Json.Serialize(Model.DomainLabels)),

                datasets: [{

                    data: @Html.Raw(Json.Serialize(Model.DomainValues)),

                    backgroundColor: domainColors,

                    borderColor: '#ffffff',

                    borderWidth: 3,

                    hoverOffset: 5

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                cutout: '70%',

                animation: {
                    duration: 900,
                    easing: 'easeOutQuart'
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        callbacks: {

                            label: function(context) {

                                const values = context.dataset.data;

                                const total = values.reduce(
                                    (a, b) => a + Number(b),
                                    0
                                );

                                const value = Number(context.raw);

                                const percent =
                                    total > 0
                                        ? Math.round((value * 100) / total)
                                        : 0;

                                return ' ' + context.label +
                                    ' : ' + value +
                                    ' (' + percent + '%)';
                            }

                        }

                    }

                }

            }

        });

    }



    const sessionCanvas = document.getElementById('sessionChart');

    if (sessionCanvas) {

        const monthlyLabels =
                    @Html.Raw(Json.Serialize(Model.MonthlyLabels));

        const monthlyValues =
                    @Html.Raw(Json.Serialize(Model.MonthlyValues));


        const labels12 =
            monthlyLabels.slice(-12);

        const values12 =
            monthlyValues.slice(-12);


        const context =
            sessionCanvas.getContext('2d');


        const gradient =
            context.createLinearGradient(0, 0, 0, 250);


        gradient.addColorStop(
            0,
            'rgba(18,168,224,.28)'
        );


        gradient.addColorStop(
            1,
            'rgba(18,168,224,0)'
        );


        new Chart(sessionCanvas, {

            type: 'line',

            data: {

                labels: labels12,

                datasets: [{

                    data: values12,

                    borderColor: '#14297a',

                    backgroundColor: gradient,

                    fill: true,

                    tension: .38,

                    borderWidth: 3,

                    pointRadius: 4,

                    pointHoverRadius: 6,

                    pointBackgroundColor: '#12A8E0',

                    pointBorderColor: '#ffffff',

                    pointBorderWidth: 2

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {
                    intersect: false,
                    mode: 'index'
                },

                animation: {
                    duration: 1000,
                    easing: 'easeOutQuart'
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        displayColors: false,

                        callbacks: {

                            label: function(context) {

                                return context.raw +
                                    ' session' +
                                    (Number(context.raw) > 1 ? 's' : '');

                            }

                        }

                    }

                },

                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        ticks: {
                            color: '#94a3b8',
                            font: {
                                size: 10
                            }
                        }

                    },

                    y: {

                        beginAtZero: true,

                        ticks: {

                            precision: 0,

                            stepSize: 1,

                            color: '#94a3b8',

                            font: {
                                size: 10
                            }

                        },

                        grid: {

                            color: 'rgba(226,232,240,.7)'

                        }

                    }

                }

            }

        });

    }

</script>
