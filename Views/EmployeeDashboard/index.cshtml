@model Training_tunisie_telecome.Models.ViewModels.EmployeeDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}

@section Styles {
    <style>
        .dashboard-page {
            background: #f7f7fb;
            border-radius: 22px;
            padding: 20px;
        }

        .dashboard-welcome {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 18px;
        }

        .welcome-title {
            margin: 0;
            color: #14297a;
            font-size: 24px;
            font-weight: 750;
        }

        .welcome-subtitle {
            margin: 4px 0 0;
            color: #718096;
            font-size: 13px;
        }

        .today-card {
            height: 42px;
            padding: 0 16px;
            background: #fff;
            border: 1px solid #e8ebf2;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 9px;
            color: #14297a;
            font-size: 13px;
            white-space: nowrap;
        }

            .today-card i {
                color: #14297a;
            }

        .success-message {
            margin-bottom: 16px;
            padding: 11px 13px;
            border: 1px solid #bbf7d0;
            background: #f0fdf4;
            color: #15803d;
            border-radius: 10px;
            font-size: 12.5px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 18px;
        }

        .kpi-card {
            min-height: 174px;
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            text-align: center;
            transition: transform .22s ease, box-shadow .22s ease;
        }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 24px rgba(20,41,122,.09);
            }

        .kpi-pink {
            border: 1.5px solid #f9a8d4;
        }

        .kpi-green {
            border: 1.5px solid #86efac;
        }

        .kpi-blue {
            border: 1.5px solid #bae6fd;
        }

        .kpi-orange {
            border: 1.5px solid #fed7aa;
        }

        .kpi-icon {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            margin: 0 auto 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
        }

        .icon-pink {
            background: #fce7f3;
            color: #db2777;
        }

        .icon-green {
            background: #dcfce7;
            color: #16a34a;
        }

        .icon-blue {
            background: #e0f2fe;
            color: #0284c7;
        }

        .icon-orange {
            background: #ffedd5;
            color: #ea580c;
        }

        .kpi-label {
            color: #718096;
            font-size: 13px;
            margin-bottom: 3px;
        }

        .kpi-number {
            color: #14297a;
            font-size: 27px;
            font-weight: 700;
            line-height: 1.1;
        }

        .kpi-caption {
            margin-top: 7px;
            color: #94a3b8;
            font-size: 11.5px;
        }

        .dashboard-card {
            background: #fff;
            border: 1px solid #e8ebf2;
            border-radius: 18px;
            padding: 18px;
        }

        .card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 8px;
        }

            .card-head h3 {
                color: #14297a;
                font-size: 16px;
                margin: 0;
            }

        .view-all {
            color: #4338ca;
            font-size: 12px;
            font-weight: 650;
            text-decoration: none;
        }

        .formation-row {
            display: grid;
            grid-template-columns: 62px 1fr auto;
            gap: 14px;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid #f0f2f6;
        }

            .formation-row:last-child {
                border-bottom: none;
            }

        .date-box {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            background: #eef2ff;
            color: #4338ca;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

            .date-box strong {
                font-size: 19px;
                line-height: 1;
            }

            .date-box span {
                font-size: 9px;
                font-weight: 700;
                margin-top: 4px;
                text-transform: uppercase;
            }

        .formation-title {
            color: #1e293b;
            font-weight: 700;
            font-size: 13.5px;
            margin-bottom: 5px;
        }

        .formation-meta {
            color: #718096;
            font-size: 11px;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

            .formation-meta i {
                color: #94a3b8;
                margin-right: 3px;
            }

        .badge-status {
            display: inline-flex;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 10.5px;
            font-weight: 700;
            white-space: nowrap;
        }

        .confirmed {
            background: #dcfce7;
            color: #16a34a;
        }

        .pending {
            background: #fff7ed;
            color: #ea580c;
        }

        .empty {
            padding: 34px 10px;
            text-align: center;
            color: #94a3b8;
            font-size: 13px;
        }

        @@media (max-width: 1050px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 650px) {
            .dashboard-page {
                padding: 15px;
            }

            .dashboard-welcome {
                flex-direction: column;
                align-items: flex-start;
            }

            .kpi-grid {
                grid-template-columns: 1fr;
            }

            .formation-row {
                grid-template-columns: 52px 1fr;
            }

                .formation-row > :last-child {
                    grid-column: 2;
                    justify-self: start;
                }
        }
    </style>
}

<div class="dashboard-page">

    @if (TempData["PasswordChanged"] != null)
    {
        <div class="success-message">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["PasswordChanged"]
        </div>
    }

    <div class="dashboard-welcome">
        <div>
            <h1 class="welcome-title">Bienvenue, @Model.FullName</h1>
            <p class="welcome-subtitle">Vue synthétique de votre activité de formation</p>
        </div>

        <div class="today-card">
            <i class="fa-solid fa-calendar-day"></i>
            Aujourd'hui : @DateTime.Today.ToString("dd/MM/yyyy")
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card kpi-pink">
            <div class="kpi-icon icon-pink"><i class="fa-solid fa-user-check"></i></div>
            <div class="kpi-label">Taux de présence</div>
            <div class="kpi-number">@Model.AttendanceRate.ToString("0.#")%</div>
            <div class="kpi-caption">selon les présences enregistrées</div>
        </div>

        <div class="kpi-card kpi-green">
            <div class="kpi-icon icon-green"><i class="fa-solid fa-calendar-check"></i></div>
            <div class="kpi-label">Formations planifiées</div>
            <div class="kpi-number">@Model.PlannedFormations</div>
            <div class="kpi-caption">formations à venir</div>
        </div>

        <div class="kpi-card kpi-blue">
            <div class="kpi-icon icon-blue"><i class="fa-solid fa-graduation-cap"></i></div>
            <div class="kpi-label">Formations suivies</div>
            <div class="kpi-number">@Model.CompletedFormations</div>
            <div class="kpi-caption">formations terminées</div>
        </div>

        <div class="kpi-card kpi-orange">
            <div class="kpi-icon icon-orange"><i class="fa-solid fa-clipboard-list"></i></div>
            <div class="kpi-label">Évaluations à remplir</div>
            <div class="kpi-number">@Model.PendingEvaluations</div>
            <div class="kpi-caption">actions en attente</div>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="card-head">
            <h3>Prochaines formations</h3>
            <a asp-controller="EmployeePortal" asp-action="Formations" class="view-all">Voir toutes</a>
        </div>

        @if (Model.UpcomingFormations.Count > 0)
        {
            foreach (var formation in Model.UpcomingFormations)
            {
                <div class="formation-row">
                    <div class="date-box">
                        <strong>@formation.DateStart.ToString("dd")</strong>
                        <span>@formation.DateStart.ToString("MMM")</span>
                    </div>

                    <div>
                        <div class="formation-title">@formation.Title</div>
                        <div class="formation-meta">
                            <span><i class="fa-regular fa-calendar"></i>@formation.DateStart.ToString("dd/MM/yyyy") → @formation.DateEnd.ToString("dd/MM/yyyy")</span>
                            <span><i class="fa-solid fa-chalkboard-user"></i>@formation.Trainer</span>
                            <span><i class="fa-solid fa-location-dot"></i>@formation.Location</span>
                        </div>
                    </div>

                    @if (formation.Confirmed == true)
                    {
                        <span class="badge-status confirmed">Confirmée</span>
                    }
                    else
                    {
                        <span class="badge-status pending">En attente</span>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty">Aucune formation planifiée pour le moment.</div>
        }
    </div>
</div>
