@using Microsoft.EntityFrameworkCore
@using Training_tunisie_telecome.Data

@inject AppDbContext _context

@{
    Layout = null;

    var pendingAbsences = await _context.SessionParticipants
        .CountAsync(p => p.AbsenceStatus == "En attente"
                      && p.JustificationFile != null);
}

<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="utf-8" />

    <title>@ViewData["Title"]</title>


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


    <style>


            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI', Arial, sans-serif;
            }



            body {
                background: #f4f2f8;
            }





            /* ================= SIDEBAR ================= */


            .sidebar {
                position: fixed;
                width: 215px;
                height: 100vh;
                background: white;
                border-right: 1px solid #ececf3;
                padding: 0 16px 20px 16px;
                display: flex;
                flex-direction: column;
                box-shadow: 2px 0 12px rgba(60,24,87,0.04);
            }





            /* LOGO */


            .logo {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                margin-bottom: 10px;
                padding: 0 4px 14px 0;
                border-bottom: 1px solid #f0edf5;
            }





                .logo img {
                    width: 175px;
                }





            /* MENU */


            .menu {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 4px;
            }





                .menu a {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 12px 14px;
                    border-radius: 10px;
                    text-decoration: none;
                    color: #4a4a55;
                    font-size: 15px;
                    font-weight: 500;
                    transition: .2s;
                }





                    .menu a i {
                        width: 20px;
                        text-align: center;
                        font-size: 17px;
                        opacity: .9;
                        transition: .3s;
                    }





                    /* COLORS FROM TT LOGO */


                    .menu a:nth-child(1) i {
                        color: #14297a;
                    }


                    .menu a:nth-child(2) i {
                        color: #0099cc;
                    }


                    .menu a:nth-child(3) i {
                        color: #f5b400;
                    }


                    .menu a:nth-child(4) i {
                        color: #e6007e;
                    }


                    .menu a:nth-child(5) i {
                        color: #ff8c00;
                    }


                    .menu a:nth-child(6) i {
                        color: #7b2cbf;
                    }





                    .menu a:hover {
                        background: #f3ecfb;
                        color: #14297a;
                        transform: translateX(3px);
                    }





                        .menu a:hover i {
                            transform: scale(1.15);
                        }







            /* LOGOUT */


            .logout {
                margin-top: 12px;
                padding: 12px 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                background: #fdeceb;
                color: #d9362d;
                font-weight: 600;
                font-size: 15px;
                border-radius: 10px;
                cursor: pointer;
                transition: .2s;
            }





                .logout i {
                    font-size: 16px;
                }





                .logout:hover {
                    background: #d9362d;
                    color: white;
                }








            /* ================= MAIN ================= */


            .main {
                margin-left: 215px;
            }





            /* TOPBAR */


            .topbar {
                height: 68px;
                background: white;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 28px;
                border-bottom: 1px solid #ececf3;
                box-shadow: 0 2px 10px rgba(60,24,87,.03);
            }







            .topbar-left {
                display: flex;
                align-items: center;
                gap: 16px;
            }






                .topbar-left i {
                    font-size: 18px;
                    color: #14297a;
                    cursor: pointer;
                }





                .topbar-left h3 {
                    font-size: 19px;
                    color: #14297a;
                    font-weight: 700;
                }







            .topbar-right {
                display: flex;
                align-items: center;
                gap: 22px;
            }





            .user-info {
                display: flex;
                align-items: center;
                gap: 10px;
            }





                .user-info span {
                    font-size: 14px;
                    font-weight: 600;
                    color: #2c2c2c;
                }





                .user-info img {
                    width: 42px;
                    height: 42px;
                    border-radius: 50%;
                    object-fit: cover;
                    border: 2px solid #f3ecfb;
                }







            /* CONTENT */


            .content {
                padding: 28px;
            }

    
            .notification-link {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: #f7f7fb;
                border: 1px solid #ececf3;
                color: #14297a;
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                position: relative;
            }

            .notification-badge {
                position: absolute;
                top: -6px;
                right: -6px;
                min-width: 18px;
                height: 18px;
                border-radius: 50%;
                background: #e6007e;
                color: white;
                font-size: 10px;
                font-weight: bold;
                display: flex;
                align-items: center;
                justify-content: center;
            }

    </style>


</head>



<body>



    <div class="sidebar">



        <div class="logo">

            <img src="/images/tt-logo.png" />

        </div>





        <div class="menu">


            <a asp-controller="Dashboard" asp-action="Index">

            

                <i class="fa fa-gauge"></i>

                Dashboard

            </a>





            <a asp-controller="Employees" asp-action="Index">

                <i class="fa fa-users"></i>

                Employés

            </a>





            <a asp-controller="Formateurs" asp-action="Index">

                <i class="fa fa-chalkboard-user"></i>

                Formateurs

            </a>





            <a asp-controller="Formations" asp-action="Index">

                <i class="fa fa-graduation-cap"></i>

                Formations

            </a>




            <a asp-controller="Attendance" asp-action="Index">

            
                <i class="fa fa-calendar"></i>

                Présence

            </a>



            <a href="/Reporting/Index">

                <i class="fa fa-chart-line"></i>

                Reporting

            </a>



        </div>







        <a href="/Auth/Logout"
           class="logout"
           style="text-decoration:none;">


            <i class="fa fa-right-from-bracket"></i>

            Déconnexion


        </a>



    </div>







    <div class="main">



        <div class="topbar">



            <div class="topbar-left">


                <i class="fa fa-bars"></i>


                <h3>
                    @ViewData["Title"]
                </h3>


            </div>







            <div class="topbar-right">


                <a asp-controller="Dashboard"
                   asp-action="Absences"
                   class="notification-link">

                    <i class="fa-solid fa-bell"></i>

                    @if (pendingAbsences > 0)
                    {
                        <span class="notification-badge">
                            @pendingAbsences
                        </span>
                    }

                </a>



                <div class="user-info">


                    <span>
                        Responsable RH
                    </span>



                    <img src="/images/responsable.jpeg" />



                </div>




            </div>




        </div>







        <div class="content">


            @RenderBody()


        </div>



    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>


    





    @RenderSection("Scripts", required: false)



</body>

</html>