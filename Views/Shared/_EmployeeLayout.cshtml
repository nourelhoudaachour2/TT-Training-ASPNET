@using Microsoft.AspNetCore.Http
@{
    Layout = null;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var displayName = Context.Session.GetString("displayName") ?? "Employé";
    var employeeImage = Context.Session.GetString("employeeImage");
    var unreadNotifications = Context.Session.GetInt32("employeeUnreadNotifications") ?? 0;

    string Active(string controller, string? action = null)
    {
        var controllerOk = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var actionOk = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return controllerOk && actionOk ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Tunisie Telecom</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI', Arial, sans-serif;
            }

            html, body {
                min-height: 100%;
            }

            body {
                background: #f4f2f8;
                color: #334155;
            }

            /* ================= SIDEBAR ================= */
            .employee-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: 215px;
                height: 100vh;
                background: #fff;
                border-right: 1px solid #ececf3;
                padding: 0 16px 20px;
                display: flex;
                flex-direction: column;
                box-shadow: 2px 0 12px rgba(60,24,87,.04);
                z-index: 1000;
                transition: width .22s ease, transform .22s ease;
            }

            .employee-logo {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                margin-bottom: 10px;
                padding: 0 4px 14px 0;
                border-bottom: 1px solid #f0edf5;
                min-height: 104px;
            }

                .employee-logo img {
                    width: 175px;
                    max-width: 100%;
                    transition: width .22s ease;
                }

            .employee-menu {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 4px;
                overflow-y: auto;
                overflow-x: hidden;
                padding-top: 2px;
            }

                .employee-menu a {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 12px 14px;
                    border-radius: 10px;
                    text-decoration: none;
                    color: #4a4a55;
                    font-size: 14.5px;
                    font-weight: 500;
                    transition: .2s;
                    white-space: nowrap;
                }

                    .employee-menu a i {
                        width: 20px;
                        min-width: 20px;
                        text-align: center;
                        font-size: 17px;
                        opacity: .95;
                        transition: .2s;
                    }

                    .employee-menu a:nth-child(1) i {
                        color: #14297a;
                    }

                    .employee-menu a:nth-child(2) i {
                        color: #e6007e;
                    }

                    .employee-menu a:nth-child(3) i {
                        color: #12a8e0;
                    }

                    .employee-menu a:nth-child(4) i {
                        color: #f5b400;
                    }

                    .employee-menu a:nth-child(5) i {
                        color: #7b2cbf;
                    }

                    .employee-menu a:nth-child(6) i {
                        color: #ff7518;
                    }

                    .employee-menu a:nth-child(7) i {
                        color: #ff7518;
                    }

                    .employee-menu a:hover,
                    .employee-menu a.active {
                        background: #f3ecfb;
                        color: #14297a;
                        transform: translateX(3px);
                    }

                    .employee-menu a.active {
                        font-weight: 700;
                    }

                        .employee-menu a:hover i,
                        .employee-menu a.active i {
                            transform: scale(1.12);
                        }

            .employee-logout {
                margin-top: 12px;
                padding: 12px 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                background: #fdeceb;
                color: #d9362d;
                font-weight: 600;
                font-size: 15px;
                border-radius: 10px;
                text-decoration: none;
                transition: .2s;
                white-space: nowrap;
            }

                .employee-logout:hover {
                    background: #d9362d;
                    color: #fff;
                }

            /* ================= MAIN / TOPBAR ================= */
            .employee-main {
                margin-left: 215px;
                min-height: 100vh;
                transition: margin-left .22s ease;
            }

            .employee-topbar {
                height: 68px;
                background: #fff;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 28px;
                border-bottom: 1px solid #ececf3;
                box-shadow: 0 2px 10px rgba(60,24,87,.03);
                position: sticky;
                top: 0;
                z-index: 900;
            }

            .employee-topbar-left {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .sidebar-toggle {
                border: 0;
                background: transparent;
                color: #14297a;
                font-size: 19px;
                cursor: pointer;
                padding: 5px;
            }

            .employee-topbar-left h3 {
                font-size: 19px;
                color: #14297a;
                font-weight: 700;
                margin: 0;
            }

            .employee-topbar-right {
                display: flex;
                align-items: center;
                gap: 18px;
            }

            .notification-link {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: #f7f7fb;
                border: 1px solid #ececf3;
                color: #14297a;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                position: relative;
                transition: .2s;
            }

                .notification-link:hover {
                    background: #eef2ff;
                    color: #4338ca;
                }

            .notification-badge {
                position: absolute;
                top: -5px;
                right: -5px;
                min-width: 18px;
                height: 18px;
                padding: 0 5px;
                border-radius: 999px;
                background: #e6007e;
                color: #fff;
                font-size: 9px;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #fff;
            }

            .employee-user-info {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .employee-user-text {
                text-align: right;
                line-height: 1.2;
            }

            .employee-user-name {
                display: block;
                color: #2c2c2c;
                font-size: 13.5px;
                font-weight: 650;
                max-width: 180px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .employee-user-role {
                display: block;
                margin-top: 2px;
                color: #94a3b8;
                font-size: 10.5px;
                font-weight: 500;
            }

            .employee-avatar,
            .employee-avatar-fallback {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #f3ecfb;
            }

            .employee-avatar-fallback {
                display: flex;
                align-items: center;
                justify-content: center;
                background: #eef2ff;
                color: #4338ca;
                font-size: 16px;
            }

            .employee-content {
                padding: 28px;
            }

            /* ================= COLLAPSED DESKTOP ================= */
            body.sidebar-collapsed .employee-sidebar {
                width: 78px;
                padding-left: 10px;
                padding-right: 10px;
            }

            body.sidebar-collapsed .employee-main {
                margin-left: 78px;
            }

            body.sidebar-collapsed .employee-logo {
                justify-content: center;
                padding-right: 0;
            }

                body.sidebar-collapsed .employee-logo img {
                    width: 56px;
                }

            body.sidebar-collapsed .employee-menu a {
                justify-content: center;
                padding-left: 10px;
                padding-right: 10px;
            }

                body.sidebar-collapsed .employee-menu a span,
                body.sidebar-collapsed .employee-logout span {
                    display: none;
                }

            body.sidebar-collapsed .employee-logout {
                padding-left: 10px;
                padding-right: 10px;
            }

            .employee-overlay {
                display: none;
            }

            @@media (max-width: 900px) {
                .employee-sidebar {
                    transform: translateX(-100%);
                    width: 215px;
                }

                .employee-main,
                body.sidebar-collapsed .employee-main {
                    margin-left: 0;
                }

                body.mobile-sidebar-open .employee-sidebar {
                    transform: translateX(0);
                }

                body.mobile-sidebar-open .employee-overlay {
                    display: block;
                    position: fixed;
                    inset: 0;
                    background: rgba(15,23,42,.28);
                    z-index: 950;
                }

                body.sidebar-collapsed .employee-sidebar {
                    width: 215px;
                    padding: 0 16px 20px;
                }

                body.sidebar-collapsed .employee-logo {
                    justify-content: flex-start;
                }

                    body.sidebar-collapsed .employee-logo img {
                        width: 175px;
                    }

                body.sidebar-collapsed .employee-menu a {
                    justify-content: flex-start;
                    padding: 12px 14px;
                }

                    body.sidebar-collapsed .employee-menu a span,
                    body.sidebar-collapsed .employee-logout span {
                        display: inline;
                    }

                .employee-topbar {
                    padding: 0 18px;
                }

                .employee-content {
                    padding: 18px;
                }
            }

            @@media (max-width: 600px) {
                .employee-user-text {
                    display: none;
                }

                .employee-topbar-right {
                    gap: 10px;
                }

                .employee-topbar-left h3 {
                    font-size: 17px;
                }

                .employee-content {
                    padding: 14px;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="employee-overlay" id="employeeOverlay"></div>

    <aside class="employee-sidebar" id="employeeSidebar">
        <div class="employee-logo">
            <img src="/images/tt-logo.png" alt="Tunisie Telecom" />
        </div>

        <nav class="employee-menu">
            <a asp-controller="EmployeeDashboard" asp-action="Index" class='@Active("EmployeeDashboard")'>
                <i class="fa-solid fa-gauge-high"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="EmployeePortal" asp-action="Profile" class='@Active("EmployeePortal", "Profile")'>
                <i class="fa-solid fa-user"></i>
                <span>Mon espace</span>
            </a>

            <a asp-controller="EmployeePortal" asp-action="Formations" class='@Active("EmployeePortal", "Formations")'>
                <i class="fa-solid fa-graduation-cap"></i>
                <span>Mes formations</span>
            </a>

            <a asp-controller="EmployeePortal" asp-action="History" class='@Active("EmployeePortal", "History")'>
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>Historique</span>
            </a>

            <a asp-controller="EmployeePortal" asp-action="Absences" class='@Active("EmployeePortal", "Absences")'>
                <i class="fa-solid fa-calendar-xmark"></i>
                <span>Mes absences</span>
            </a>

            <a asp-controller="EmployeePortal" asp-action="Notifications" class='@Active("EmployeePortal", "Notifications")'>
                <i class="fa-solid fa-bell"></i>
                <span>Notifications</span>
            </a>
        </nav>

        <a asp-controller="Auth" asp-action="Logout" class="employee-logout">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>Déconnexion</span>
        </a>
    </aside>

    <main class="employee-main">
        <header class="employee-topbar">
            <div class="employee-topbar-left">
                <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Afficher ou masquer le menu">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h3>@ViewData["Title"]</h3>
            </div>

            <div class="employee-topbar-right">
                <a asp-controller="EmployeePortal" asp-action="Notifications" class="notification-link" title="Notifications">
                    <i class="fa-regular fa-bell"></i>
                    @if (unreadNotifications > 0)
                    {
                        <span class="notification-badge">@(unreadNotifications > 99 ? "99+" : unreadNotifications.ToString())</span>
                    }
                </a>

                <div class="employee-user-info">
                    <div class="employee-user-text">
                        <span class="employee-user-name">@displayName</span>
                        <span class="employee-user-role">Employé</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(employeeImage))
                    {
                        <img src="@employeeImage" alt="Photo employé" class="employee-avatar" />
                    }
                    else
                    {
                        <div class="employee-avatar-fallback">
                            <i class="fa-solid fa-user"></i>
                        </div>
                    }
                </div>
            </div>
        </header>

        <section class="employee-content">
            @RenderBody()
        </section>
    </main>

    <script>
            (function() {
                const toggle = document.getElementById('sidebarToggle');
                const overlay = document.getElementById('employeeOverlay');

                function isMobile() {
                    return window.innerWidth <= 900;
                }

                function toggleSidebar() {
                    if (isMobile()) {
                        document.body.classList.toggle('mobile-sidebar-open');
                    } else {
                        document.body.classList.toggle('sidebar-collapsed');
                    }
                }

                toggle.addEventListener('click', toggleSidebar);

                overlay.addEventListener('click', function() {
                    document.body.classList.remove('mobile-sidebar-open');
                });

                window.addEventListener('resize', function() {
                    if (!isMobile()) {
                        document.body.classList.remove('mobile-sidebar-open');
                    }
                });
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
