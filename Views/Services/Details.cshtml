@model Training_tunisie_telecome.Models.Service

@{
    ViewData["Title"] = "Détails Service";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .service-details-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 5px 25px rgba(0,0,0,.05);
    }

    .service-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eeeeee;
    }

    .service-icon {
        width: 55px;
        height: 55px;
        border-radius: 12px;
        background: #e8edff;
        color: #14297a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .service-info h2 {
        color: #14297a;
        font-size: 18px;
        margin: 0 0 6px;
    }

    .service-info p {
        color: #6b7280;
        font-size: 13px;
        margin: 0;
    }

    .section-title {
        margin: 22px 0 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #14297a;
        font-size: 14px;
        font-weight: 700;
    }

    .section-icon {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: #e8edff;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 11px;
    }

    .employee-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 15px;
    }

    .employee-card {
        border: 1.5px solid #d1d5db;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
    }

    .employee-image {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        object-fit: cover;
    }

    .no-image {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: #e8edff;
        color: #14297a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin: auto;
    }

    .employee-name {
        margin-top: 10px;
        color: #14297a;
        font-weight: 600;
        font-size: 13px;
    }

    .employee-info {
        margin-top: 8px;
        color: #6b7280;
        font-size: 12px;
    }

        .employee-info strong {
            color: #374151;
            font-weight: 600;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
        padding: 9px 20px;
        border-radius: 9px;
        border: 1px solid #d1d5db;
        color: #374151;
        text-decoration: none;
        font-weight: 600;
        font-size: 12px;
    }
</style>

<div class="service-details-card">

    <div class="service-header">

        <div class="service-icon">
            <i class="fa fa-building"></i>
        </div>

        <div class="service-info">
            <h2>@Model.Name</h2>
            <p>@Model.Description</p>
        </div>

    </div>


    <div class="section-title">

        <div class="section-icon">
            <i class="fa fa-users"></i>
        </div>

        Liste des employés

    </div>


    @if (Model.Employees != null && Model.Employees.Any())
    {

        <div class="employee-grid">

            @foreach (var employee in Model.Employees)
            {

                <div class="employee-card">

                    @if (!string.IsNullOrEmpty(employee.ImagePath))
                    {
                        <img src="@employee.ImagePath" class="employee-image" />
                    }
                    else
                    {
                        <div class="no-image">
                            <i class="fa fa-user"></i>
                        </div>
                    }

                    <div class="employee-name">
                        @employee.FirstName @employee.LastName
                    </div>

                    <div class="employee-info">

                        <div>
                            <strong>Matricule:</strong>
                            @employee.Matricule
                        </div>

                        <div>
                            <strong>Téléphone:</strong>
                            @employee.PhoneNumber
                        </div>

                    </div>

                </div>

            }

        </div>

    }
    else
    {
        <p>Aucun employé dans ce service.</p>
    }


    <a asp-action="Index" class="btn-back">
        <i class="fa fa-arrow-left"></i>
        Retour aux services
    </a>

</div>
