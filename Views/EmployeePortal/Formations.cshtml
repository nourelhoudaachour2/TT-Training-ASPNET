@model Training_tunisie_telecome.Models.ViewModels.EmployeeFormationsPageViewModel

@{
    ViewData["Title"] = "Mes formations";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}

@section Styles {
    <style>
        .page-shell {
            background: #f6f7fb;
            border-radius: 22px;
            padding: 24px;
        }

        .message {
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 16px;
            font-size: 12.5px;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .message-success {
            background: #ecfdf5;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .message-error {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .formation-list {
            display: grid;
            gap: 14px;
        }

        /* ----- Card ----- */
        .formation-card {
            position: relative;
            background: #ffffff;
            border: 1px solid #eceef4;
            border-radius: 18px;
            padding: 20px 22px;
            padding-left: 26px;
            display: grid;
            grid-template-columns: 76px 1fr auto;
            gap: 20px;
            align-items: center;
            box-shadow: 0 2px 10px rgba(20,41,122,.05);
            transition: .2s ease;
        }

            .formation-card::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 5px;
                border-radius: 18px 0 0 18px;
                background: #cbd5e1; /* default = en attente */
            }

            .formation-card.is-confirmed::before {
                background: #22c55e;
            }

            .formation-card.is-pending::before {
                background: #f59e0b;
            }

            .formation-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 26px rgba(20,41,122,.10);
                border-color: #e1e5f0;
            }

        /* ----- Date box ----- */
        .date-box {
            width: 68px;
            height: 68px;
            border-radius: 15px;
            background: #f5f7ff;
            border: 1px solid #e2e6f5;
            color: #14297a;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

            .is-confirmed .date-box {
                background: #ecfdf5;
                border-color: #86efac;
                color: #16a34a;
            }

            .is-pending .date-box {
                background: #fff7ed;
                border-color: #fdba74;
                color: #ea580c;
            }

            .date-box strong {
                font-size: 21px;
                line-height: 1;
                font-weight: 800;
            }

            .date-box span {
                font-size: 9px;
                font-weight: 700;
                margin-top: 4px;
                letter-spacing: .04em;
                text-transform: uppercase;
                color: inherit;
                opacity: .75;
            }

        /* ----- Content ----- */
        .formation-title {
            color: #14297a;
            font-size: 15px;
            font-weight: 750;
            margin-bottom: 6px;
        }

        .formation-module {
            display: inline-block;
            background: #f1f2f9;
            color: #5b6478;
            border-radius: 7px;
            padding: 3px 8px;
            font-size: 10.5px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .meta {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            color: #8592a6;
            font-size: 11.5px;
        }

            .meta i {
                color: #a7b0c4;
                margin-right: 4px;
                width: 12px;
            }

        /* ----- Side ----- */
        .side {
            min-width: 200px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
        }

        .status {
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 10.5px;
            font-weight: 700;
        }

        .ok {
            background: #dcfce7;
            color: #16a34a;
        }

        .wait {
            background: #fef3c7;
            color: #b45309;
        }

        .replacement {
            color: #6d28d9;
            background: #f4f0ff;
            border-radius: 8px;
            padding: 7px 10px;
            font-size: 10.5px;
            text-align: right;
            line-height: 1.4;
        }

        .replacement-button {
            border: 1px solid #e2e6f5;
            background: #fff;
            color: #14297a;
            border-radius: 9px;
            padding: 9px 12px;
            font-size: 11px;
            font-weight: 650;
            cursor: pointer;
            transition: .15s;
        }

            .replacement-button:hover {
                background: #f5f7ff;
                border-color: #c7cdec;
            }

            .replacement-button i {
                margin-right: 6px;
                color: #6d5ffb;
            }

        .empty {
            background: #fff;
            border: 1px dashed #dfe3ec;
            border-radius: 16px;
            padding: 40px;
            text-align: center;
            color: #a7b0c4;
            font-size: 13px;
        }

        /* ----- MODAL ----- */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .45);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 5000;
            padding: 20px;
        }

            .modal-overlay.show {
                display: flex;
            }

        .replacement-modal {
            width: 460px;
            max-width: 100%;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 22px 55px rgba(15,23,42,.22);
            overflow: hidden;
        }

        .modal-head {
            padding: 20px 22px 16px;
            border-bottom: 1px solid #eef0f5;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 15px;
        }

        .modal-title {
            color: #14297a;
            font-size: 16px;
            font-weight: 750;
            margin-bottom: 4px;
        }

        .modal-subtitle {
            color: #8592a6;
            font-size: 11.5px;
        }

        .modal-close {
            width: 32px;
            height: 32px;
            border: 0;
            border-radius: 9px;
            background: #f5f7ff;
            color: #64748b;
            cursor: pointer;
        }

        .modal-body {
            padding: 22px;
        }

        .modal-label {
            display: block;
            color: #334155;
            font-size: 12px;
            font-weight: 650;
            margin-bottom: 8px;
        }

        .modal-select {
            width: 100%;
            height: 44px;
            border: 1px solid #dfe3ec;
            border-radius: 10px;
            padding: 0 12px;
            outline: none;
            color: #334155;
            background: #fff;
        }

            .modal-select:focus {
                border-color: #6d5ffb;
                box-shadow: 0 0 0 3px rgba(109,95,251,.10);
            }

        .modal-note {
            display: flex;
            gap: 8px;
            color: #8592a6;
            background: #f8f9fd;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 10.5px;
            line-height: 1.5;
            margin-top: 12px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 9px;
            padding: 16px 22px 22px;
        }

        .btn-cancel,
        .btn-send {
            height: 39px;
            border-radius: 9px;
            padding: 0 16px;
            font-size: 11.5px;
            font-weight: 650;
            cursor: pointer;
            border: 0;
        }

        .btn-cancel {
            background: #f1f5f9;
            color: #475569;
        }

        .btn-send {
            background: #14297a;
            color: #fff;
        }

            .btn-send:hover {
                background: #0f1f5e;
            }

        @@media(max-width:700px) {
            .formation-card {
                grid-template-columns: 56px 1fr;
            }

            .side {
                grid-column: 2;
                min-width: 0;
                align-items: flex-start;
            }
        }
    </style>
}

<div class="page-shell">

    @if (TempData["ReplacementSuccess"] != null)
    {
        <div class="message message-success">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["ReplacementSuccess"]
        </div>
    }

    @if (TempData["ReplacementError"] != null)
    {
        <div class="message message-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            @TempData["ReplacementError"]
        </div>
    }

    <div class="formation-list">

        @if (Model.Upcoming.Count > 0)
        {
            foreach (var formation in Model.Upcoming)
            {
                var statusClass = formation.Confirmed == true ? "is-confirmed" : "is-pending";

                <div class="formation-card @statusClass">

                    <div class="date-box">
                        <strong>@formation.DateStart.ToString("dd")</strong>
                        <span>@formation.DateStart.ToString("MMM")</span>
                    </div>

                    <div>
                        <div class="formation-title">
                            @formation.Title
                        </div>

                        @if (!string.IsNullOrWhiteSpace(formation.Module))
                        {
                            <span class="formation-module">
                                @formation.Module
                            </span>
                        }

                        <div class="meta">

                            <span>
                                <i class="fa-regular fa-calendar"></i>
                                @formation.DateStart.ToString("dd/MM/yyyy")
                                →
                                @formation.DateEnd.ToString("dd/MM/yyyy")
                            </span>

                            <span>
                                <i class="fa-solid fa-chalkboard-user"></i>
                                @formation.Trainer
                            </span>

                            <span>
                                <i class="fa-solid fa-location-dot"></i>
                                @formation.Location
                            </span>

                        </div>
                    </div>

                    <div class="side">

                        @if (formation.Confirmed == true)
                        {
                            <span class="status ok">
                                <i class="fa-solid fa-circle-check"></i> Confirmée
                            </span>
                        }
                        else
                        {
                            <span class="status wait">
                                <i class="fa-regular fa-clock"></i> En attente
                            </span>
                        }

                        @if (formation.ReplacementEmployeeId != null)
                        {
                            <span class="replacement">
                                <i class="fa-solid fa-right-left"></i>
                                Remplaçant proposé :
                                <strong>@formation.ReplacementEmployeeName</strong>
                            </span>
                        }

                        <button type="button"
                                class="replacement-button"
                                data-participant="@formation.ParticipantId"
                                data-title="@formation.Title"
                                data-current="@formation.ReplacementEmployeeId"
                                onclick="openReplacementModal(this)">

                            <i class="fa-solid fa-user-group"></i>

                            @(formation.ReplacementEmployeeId == null
                                ? "Je ne peux pas participer"
                                : "Modifier le remplaçant")
                        </button>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="empty">
                <i class="fa-regular fa-calendar-xmark" style="font-size:22px;display:block;margin-bottom:8px;"></i>
                Aucune formation planifiée pour le moment.
            </div>
        }

    </div>

</div>


<div class="modal-overlay" id="replacementModal">

    <div class="replacement-modal">

        <div class="modal-head">

            <div>
                <div class="modal-title">
                    Demander un remplacement
                </div>

                <div class="modal-subtitle" id="replacementFormationTitle">
                    Formation
                </div>
            </div>

            <button type="button"
                    class="modal-close"
                    onclick="closeReplacementModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>

        <form asp-controller="EmployeePortal"
              asp-action="RequestReplacement"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="participantId"
                   id="replacementParticipantId" />

            <div class="modal-body">

                <label class="modal-label">
                    Collègue proposé
                </label>

                <select class="modal-select"
                        id="replacementEmployeeId"
                        name="replacementEmployeeId"
                        required>

                    <option value="">
                        -- Sélectionner un collègue --
                    </option>

                    @foreach (var colleague in Model.AvailableReplacements)
                    {
                        <option value="@colleague.EmployeeId">
                            @colleague.FullName
                            — @colleague.Matricule
                            — @colleague.Domain
                        </option>
                    }

                </select>

                <div class="modal-note">
                    <i class="fa-regular fa-circle-question"></i>
                    <span>Le Responsable RH verra automatiquement ce collègue dans la colonne « Remplaçant » de la feuille de présence.</span>
                </div>

            </div>

            <div class="modal-actions">

                <button type="button"
                        class="btn-cancel"
                        onclick="closeReplacementModal()">
                    Annuler
                </button>

                <button type="submit"
                        class="btn-send">
                    <i class="fa-solid fa-paper-plane"></i>
                    Envoyer la demande
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <script>
        function openReplacementModal(button) {

            const modal = document.getElementById("replacementModal");
            const participantInput = document.getElementById("replacementParticipantId");
            const title = document.getElementById("replacementFormationTitle");
            const select = document.getElementById("replacementEmployeeId");

            participantInput.value = button.dataset.participant;
            title.textContent = button.dataset.title;

            select.value = button.dataset.current || "";

            modal.classList.add("show");
        }

        function closeReplacementModal() {
            document.getElementById("replacementModal")
                .classList.remove("show");
        }

        document.getElementById("replacementModal")
            .addEventListener("click", function(event) {

                if (event.target === this) {
                    closeReplacementModal();
                }
            });
    </script>
}
