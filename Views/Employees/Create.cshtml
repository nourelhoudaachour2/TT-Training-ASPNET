@model Training_tunisie_telecome.Models.Employee

@{
    ViewData["Title"] = "Employés";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: #14297a;
        margin-bottom: 8px;
    }

    .breadcrumb {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 20px;
    }

        .breadcrumb span {
            color: #14297a;
            font-weight: 600;
        }

    .form-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 25px rgba(0,0,0,.05);
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 18px;
        border-bottom: 1px solid #eeeeee;
    }

    .header-icon {
        width: 55px;
        height: 55px;
        border-radius: 12px;
        background: #e8edff;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .header-icon i {
            color: #14297a;
            font-size: 24px;
        }

    .header-text h3 {
        color: #14297a;
        font-size: 20px;
        margin-bottom: 4px;
    }

    .header-text p {
        color: #6b7280;
        font-size: 14px;
    }

    .form-body {
        margin-top: 25px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-weight: 600;
            color: #14297a;
            margin-bottom: 8px;
            font-size: 14px;
        }

    .form-control {
        width: 100%;
        height: 45px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 0 15px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #14297a;
            outline: none;
        }

    .input-validation-error {
        border: 2px solid #ef4444;
    }

    .field-validation-error {
        color: #ef4444;
        font-size: 13px;
    }

    .image-preview {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e5e7eb;
    }

    /* CUSTOM FILE UPLOAD - DROPZONE */

    .file-dropzone {
        border: 2px dashed #c7d0e8;
        border-radius: 12px;
        background: #f7f8fd;
        padding: 30px 20px;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
        position: relative;
    }

        .file-dropzone:hover {
            border-color: #14297a;
            background: #f0f3ff;
        }

        .file-dropzone.dragover {
            border-color: #14297a;
            background: #e8edff;
        }

        .file-dropzone.has-file {
            border-style: solid;
            border-color: #14297a;
            background: #f0f3ff;
        }

    .dropzone-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #e8edff;
        color: #14297a;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        font-size: 20px;
    }

    .dropzone-text {
        color: #374151;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .dropzone-link {
        color: #14297a;
        font-weight: 700;
        text-decoration: underline;
    }

    .dropzone-hint {
        color: #9ca3af;
        font-size: 12px;
        margin-top: 6px;
    }

    .dropzone-file-info {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

        .dropzone-file-info.active {
            display: flex;
        }

    .dropzone-file-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: #14297a;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .dropzone-file-name {
        color: #14297a;
        font-weight: 600;
        font-size: 14px;
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dropzone-remove {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: #fdeceb;
        color: #d9362d;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        font-size: 12px;
        flex-shrink: 0;
    }

        .dropzone-remove:hover {
            background: #d9362d;
            color: white;
        }

    .file-upload-input {
        display: none;
    }

    .buttons {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-save {
        background: #14297a;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #0d1b52;
        }

    .btn-cancel {
        background: #fdeceb;
        color: #d9362d;
        padding: 12px 35px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-cancel:hover {
            background: #d9362d;
            color: white;
        }

</style>


<h1 class="page-title">
    Ajouter un employé
</h1>

<div class="breadcrumb">
    Accueil /
    <span>Employés</span>
    /
    Ajouter
</div>


<div class="form-card">

    <div class="form-header">

        <div class="header-icon">
            <i class="fa fa-user"></i>
        </div>

        <div class="header-text">
            <h3>Informations de l'employé</h3>
            <p>Veuillez saisir les informations du nouvel employé</p>
        </div>

    </div>



    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="form-body">


            <div asp-validation-summary="ModelOnly"></div>



            <div class="form-group">
                <label>Image</label>

                <div class="file-dropzone" id="fileDropzone" onclick="document.getElementById('imageInput').click()">

                    <input type="file"
                           id="imageInput"
                           name="image"
                           class="file-upload-input"
                           accept=".jpg,.jpeg,.png"
                           onchange="handleFileSelect(this)" />

                    <div id="dropzoneDefault">

                        <div class="dropzone-icon">
                            <i class="fa fa-cloud-arrow-up"></i>
                        </div>

                        <div class="dropzone-text">
                            Glissez-déposez une image ici ou
                            <span class="dropzone-link">parcourez vos fichiers</span>
                        </div>

                        <div class="dropzone-hint">
                            PNG, JPG jusqu'à 5 Mo
                        </div>

                    </div>

                    <div id="dropzoneFileInfo" class="dropzone-file-info">

                        <div class="dropzone-file-icon">
                            <i class="fa fa-image"></i>
                        </div>

                        <span id="dropzoneFileName" class="dropzone-file-name"></span>

                        <button type="button" class="dropzone-remove" onclick="removeFile(event)">
                            <i class="fa fa-xmark"></i>
                        </button>

                    </div>

                </div>
            </div>



            <div class="form-group">

                <label>
                    Matricule <span style="color:red">*</span>
                </label>

                <input asp-for="Matricule"
                       class="form-control"
                       placeholder="Ex: 123456" />

                <span asp-validation-for="Matricule"></span>

            </div>




            <div class="form-group">

                <label>
                    Nom <span style="color:red">*</span>
                </label>

                <input asp-for="LastName"
                       class="form-control"
                       placeholder="Nom" />

                <span asp-validation-for="LastName"></span>

            </div>




            <div class="form-group">

                <label>
                    Prénom <span style="color:red">*</span>
                </label>

                <input asp-for="FirstName"
                       class="form-control"
                       placeholder="Prénom" />

                <span asp-validation-for="FirstName"></span>

            </div>




            <div class="form-group">

                <label>
                    Email <span style="color:red">*</span>
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="email@exemple.com" />

                <span asp-validation-for="Email"></span>

            </div>




            <div class="form-group">

                <label>
                    Téléphone <span style="color:red">*</span>
                </label>

                <input asp-for="PhoneNumber"
                       class="form-control"
                       placeholder="8 chiffres" />

                <span asp-validation-for="PhoneNumber"></span>

            </div>




            <div class="form-group">

                <label>
                    Grade <span style="color:red">*</span>
                </label>

                <select asp-for="Grade"
                        asp-items="ViewBag.Grades"
                        class="form-control">

                    <option value="">
                        -- Choisir Grade --
                    </option>

                </select>

                <span asp-validation-for="Grade"></span>

            </div>




            <div class="form-group">

                <label>
                    Résidence <span style="color:red">*</span>
                </label>

                <select asp-for="Residence"
                        asp-items="ViewBag.Residences"
                        class="form-control">

                    <option value="">
                        -- Choisir Résidence --
                    </option>

                </select>

                <span asp-validation-for="Residence"></span>

            </div>




            <div class="form-group">

                <label>
                    Service <span style="color:red">*</span>
                </label>

                <select asp-for="ServiceId"
                        asp-items="ViewBag.Services"
                        class="form-control">

                    <option value="">
                        -- Choisir Service --
                    </option>

                </select>

                <span asp-validation-for="ServiceId"></span>

            </div>





            <div class="buttons">

                <a asp-action="Index"
                   class="btn-cancel">

                    <i class="fa fa-arrow-left"></i>
                    Annuler

                </a>


                <button type="submit"
                        class="btn-save">

                    <i class="fa fa-save"></i>
                    Enregistrer

                </button>

            </div>


        </div>

    </form>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const dropzone = document.getElementById("fileDropzone");
        const fileInput = document.getElementById("imageInput");
        const dropzoneDefault = document.getElementById("dropzoneDefault");
        const dropzoneFileInfo = document.getElementById("dropzoneFileInfo");
        const dropzoneFileName = document.getElementById("dropzoneFileName");

        function showFile(file) {
            dropzoneDefault.style.display = "none";
            dropzoneFileInfo.classList.add("active");
            dropzoneFileName.textContent = file.name;
            dropzone.classList.add("has-file");
        }

        function handleFileSelect(input) {
            if (input.files.length > 0) {
                showFile(input.files[0]);
            }
        }

        function removeFile(event) {
            event.stopPropagation();
            fileInput.value = "";
            dropzoneDefault.style.display = "block";
            dropzoneFileInfo.classList.remove("active");
            dropzone.classList.remove("has-file");
        }

        dropzone.addEventListener("dragover", function (e) {
            e.preventDefault();
            dropzone.classList.add("dragover");
        });

        dropzone.addEventListener("dragleave", function () {
            dropzone.classList.remove("dragover");
        });

        dropzone.addEventListener("drop", function (e) {
            e.preventDefault();
            dropzone.classList.remove("dragover");

            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                showFile(e.dataTransfer.files[0]);
            }
        });

    </script>
}
