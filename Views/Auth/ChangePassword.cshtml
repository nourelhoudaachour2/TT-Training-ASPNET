@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Modifier le mot de passe</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
            * {
                box-sizing: border-box;
                font-family: 'Segoe UI', Arial, sans-serif;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: #f7f7fb;
                padding: 24px;
            }

            .card {
                width: 500px;
                max-width: 100%;
                background: #fff;
                border-radius: 20px;
                padding: 34px;
                border: 1px solid #e8ebf2;
                box-shadow: 0 14px 40px rgba(20,41,122,.10);
            }

            .logo {
                display: flex;
                justify-content: center;
                margin-bottom: 15px;
            }

                .logo img {
                    width: 255px;
                    max-width: 100%;
                }

            h2 {
                margin: 0;
                color: #14297a;
                text-align: center;
                font-size: 21px;
            }

            .subtitle {
                margin: 8px 0 23px;
                color: #718096;
                text-align: center;
                font-size: 12.5px;
                line-height: 1.5;
            }

            .group {
                margin-bottom: 18px;
            }

            label {
                display: block;
                margin-bottom: 6px;
                color: #2c3e70;
                font-size: 13px;
                font-weight: 650;
            }

            input {
                width: 100%;
                height: 43px;
                border: 1px solid #dfe3ec;
                border-radius: 10px;
                padding: 0 13px;
                outline: none;
                font-size: 13.5px;
            }

                input:focus {
                    border-color: #6d5ffb;
                    box-shadow: 0 0 0 3px rgba(109,95,251,.08);
                }

            /* Contrôle du mot de passe : une seule ligne, visible seulement pendant la saisie */
            .password-rules {
                display: none;
                align-items: center;
                gap: 10px;
                margin-top: 7px;
                min-height: 16px;
                white-space: nowrap;
                color: #ef4444;
                font-size: 10.5px;
                font-weight: 400;
            }

                .password-rules.visible {
                    display: flex;
                }

            .password-rule {
                display: inline;
                color: #ef4444;
                font-size: 10.5px;
                font-weight: 400;
                white-space: nowrap;
            }

                .password-rule.valid {
                    display: none;
                }

            .confirm-rule {
                display: none;
                margin-top: 7px;
                min-height: 16px;
            }

                .confirm-rule.visible {
                    display: block;
                }

                .confirm-rule .password-rule {
                    color: #ef4444;
                    font-size: 10.5px;
                    font-weight: 400;
                }


            .btn {
                width: 100%;
                height: 44px;
                border: none;
                border-radius: 11px;
                background: #14297a;
                color: #fff;
                font-size: 13.5px;
                font-weight: 700;
                cursor: pointer;
                margin-top: 5px;
                transition: .2s;
            }

                .btn:hover:not(:disabled) {
                    background: #0e1d5c;
                }

                .btn:disabled {
                    opacity: .5;
                    cursor: not-allowed;
                }

            .error {
                margin-bottom: 16px;
                padding: 11px 13px;
                color: #b91c1c;
                background: #fef2f2;
                border: 1px solid #fecaca;
                border-radius: 10px;
                font-size: 12.5px;
                text-align: center;
            }

            @@media (max-width: 520px) {
                .card {
                    padding: 26px 22px;
                }
            }
    </style>
</head>
<body>

    <div class="card">

        <div class="logo">
            <img src="/images/tt-logo.png" alt="Tunisie Telecom" />
        </div>

        <h2>Créer votre mot de passe</h2>

        <div class="subtitle">
            Pour votre première connexion, remplacez le mot de passe initial par votre mot de passe personnel.
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <form asp-controller="Auth"
              asp-action="ChangePassword"
              method="post"
              id="changePasswordForm">

            @Html.AntiForgeryToken()

            <div class="group">
                <label>Mot de passe actuel</label>
                <input type="password"
                       id="currentPassword"
                       name="currentPassword"
                       autocomplete="current-password"
                       placeholder="Mot de passe initial"
                       required />
            </div>

            <div class="group">
                <label>Nouveau mot de passe</label>

                <input type="password"
                       id="newPassword"
                       name="newPassword"
                       autocomplete="new-password"
                       placeholder="Saisissez votre nouveau mot de passe"
                       required />

                <div class="password-rules" id="passwordRules">
                    <span class="password-rule" id="ruleLength">8 caractères</span>
                    <span class="password-rule" id="ruleUpper">1 majuscule</span>
                    <span class="password-rule" id="ruleLower">1 minuscule</span>
                    <span class="password-rule" id="ruleDigit">1 chiffre</span>
                    <span class="password-rule" id="ruleSpecial">1 caractère spécial</span>
                </div>
            </div>

            <div class="group">
                <label>Confirmer le nouveau mot de passe</label>

                <input type="password"
                       id="confirmPassword"
                       name="confirmPassword"
                       autocomplete="new-password"
                       placeholder="Confirmez votre mot de passe"
                       required />

                <div class="confirm-rule" id="confirmRule">
                    <span class="password-rule" id="ruleMatch">
                        Les mots de passe doivent être identiques
                    </span>
                </div>
            </div>

            <button class="btn"
                    id="submitPassword"
                    type="submit"
                    disabled>
                Enregistrer et continuer
            </button>

        </form>

    </div>

    <script>
            (function() {

                const currentPassword = document.getElementById("currentPassword");
                const newPassword = document.getElementById("newPassword");
                const confirmPassword = document.getElementById("confirmPassword");
                const submitButton = document.getElementById("submitPassword");
                const passwordRules = document.getElementById("passwordRules");
                const confirmRule = document.getElementById("confirmRule");

                const rules = {
                    length: document.getElementById("ruleLength"),
                    upper: document.getElementById("ruleUpper"),
                    lower: document.getElementById("ruleLower"),
                    digit: document.getElementById("ruleDigit"),
                    special: document.getElementById("ruleSpecial"),
                    match: document.getElementById("ruleMatch")
                };

                function updateRule(element, valid) {
                    element.classList.toggle("valid", valid);
                }

                function validatePassword() {

                    const value = newPassword.value;

                    const checks = {
                        length: value.length >= 8,
                        upper: /[A-Z]/.test(value),
                        lower: /[a-z]/.test(value),
                        digit: /[0-9]/.test(value),
                        special: /[^A-Za-z0-9]/.test(value)
                    };

                    const hasStartedTyping = value.length > 0;
                    passwordRules.classList.toggle("visible", hasStartedTyping);

                    updateRule(rules.length, checks.length);
                    updateRule(rules.upper, checks.upper);
                    updateRule(rules.lower, checks.lower);
                    updateRule(rules.digit, checks.digit);
                    updateRule(rules.special, checks.special);

                    const passwordIsValid =
                        checks.length &&
                        checks.upper &&
                        checks.lower &&
                        checks.digit &&
                        checks.special;

                    const passwordsMatch =
                        confirmPassword.value.length > 0 &&
                        value === confirmPassword.value;

                    const hasStartedConfirmation = confirmPassword.value.length > 0;

                    if (!hasStartedConfirmation) {
                        confirmRule.classList.remove("visible");
                        rules.match.classList.remove("valid");
                    } else if (passwordsMatch) {
                        confirmRule.classList.remove("visible");
                        rules.match.classList.add("valid");
                    } else {
                        confirmRule.classList.add("visible");
                        rules.match.classList.remove("valid");
                    }

                    submitButton.disabled = !(
                        currentPassword.value.length > 0 &&
                        passwordIsValid &&
                        passwordsMatch
                    );
                }

                currentPassword.addEventListener("input", validatePassword);
                newPassword.addEventListener("input", validatePassword);
                confirmPassword.addEventListener("input", validatePassword);

                validatePassword();

            })();
    </script>

</body>
</html>
