@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connexion - Tunisie Telecom</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
            * {
                box-sizing: border-box;
                font-family: 'Segoe UI', Arial, sans-serif;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: #f7f7fb;
                padding: 24px;
            }

            .card {
                width: 430px;
                max-width: 100%;
                background: #fff;
                border-radius: 20px;
                padding: 34px;
                border: 1px solid #e8ebf2;
                box-shadow: 0 14px 40px rgba(20,41,122,.10);
            }

            .logo {
                display: flex;
                justify-content: center;
                margin-bottom: 16px;
            }

                .logo img {
                    width: 195px;
                }

            .title {
                text-align: center;
                font-size: 21px;
                font-weight: 750;
                color: #14297a;
                margin-bottom: 7px;
            }

            .subtitle {
                text-align: center;
                font-size: 12.5px;
                color: #718096;
                margin-bottom: 26px;
            }

            .input-group {
                margin-bottom: 17px;
            }

            label {
                display: block;
                font-size: 13px;
                font-weight: 650;
                color: #2c3e70;
                margin-bottom: 7px;
            }

            .input {
                position: relative;
            }

                .input i {
                    position: absolute;
                    left: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #14297a;
                }

                .input input {
                    width: 100%;
                    height: 44px;
                    padding: 0 14px 0 40px;
                    border: 1px solid #dfe3ec;
                    border-radius: 11px;
                    outline: none;
                    font-size: 13.5px;
                    color: #334155;
                    background: #fff;
                }

                    .input input:focus {
                        border-color: #6d5ffb;
                        box-shadow: 0 0 0 3px rgba(109,95,251,.08);
                    }

            .btn {
                width: 100%;
                height: 44px;
                margin-top: 7px;
                border: none;
                border-radius: 11px;
                background: #14297a;
                color: #fff;
                font-size: 13.5px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s;
            }

                .btn:hover {
                    background: #0e1d5c;
                }

            .error {
                margin-top: 15px;
                padding: 11px 13px;
                color: #b91c1c;
                background: #fef2f2;
                border: 1px solid #fecaca;
                border-radius: 10px;
                font-size: 12.5px;
                text-align: center;
            }

            .footer {
                margin-top: 18px;
                padding-top: 16px;
                border-top: 1px solid #f0f2f6;
                text-align: center;
                font-size: 11.5px;
                color: #94a3b8;
            }
    </style>
</head>
<body>

    <div class="card">

        <div class="logo">
            <img src="/images/tt-logo.png" alt="Tunisie Telecom" />
        </div>

        <div class="title">Connexion</div>
        <div class="subtitle">Plateforme de gestion des formations</div>

        <form asp-controller="Auth" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="input-group">
                <label>Identifiant</label>

                <div class="input">
                    <i class="fa-solid fa-user"></i>
                    <input name="identifiant"
                           value="@ViewBag.Identifiant"
                           autocomplete="username"
                           placeholder="Matricule responsable ou email employé" />
                </div>
            </div>

            <div class="input-group">
                <label>Mot de passe</label>

                <div class="input">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password"
                           name="password"
                           autocomplete="current-password"
                           placeholder="Entrez votre mot de passe" />
                </div>
            </div>

            <button class="btn" type="submit">
                Se connecter
            </button>

            @if (ViewBag.Error != null)
            {
                <div class="error">@ViewBag.Error</div>
            }
        </form>

        <div class="footer">
            Accès Responsable RH / Employé
        </div>

    </div>

</body>
</html>
